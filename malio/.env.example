# ===== API Keys =====
KIMI_API_KEY=your_kimi_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ===== Model Configuration =====
KIMI_MODEL=kimi-k2.5
KIMI_API_BASE=https://api.moonshot.cn/v1/
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== NetEase Cloud Music API =====
NETEASE_API_URL=http://localhost:3000
# 网易云 Cookie（用于获取完整音频 URL，可选）
# 从浏览器登录网易云音乐后获取，格式：NCM_COOKIE=appver=8.0.0; os=pc; osver=Win10; channel=netease; ...
NCM_COOKIE=

# ===== Database =====
DATABASE_URL=sqlite:///./malio.db

# ===== Redis (for Celery, optional) =====
REDIS_URL=redis://localhost:6379/0

# ===== Server =====
HOST=0.0.0.0
PORT=8007

# ===== Environment =====
ENVIRONMENT=development

# ===== CORS Settings =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
